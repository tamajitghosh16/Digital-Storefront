{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "RAZORPAY_KEY_ID",
        "RAZORPAY_KEY_SECRET",
        "RAZORPAY_WEBHOOK_SECRET",
        "NEXT_PUBLIC_RAZORPAY_KEY_ID",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "BLOB_READ_WRITE_TOKEN",
        "CLOUDMERSIVE_API_KEY",
        "NEXT_PUBLIC_AUTH_SUPABASE_URL",
        "NEXT_PUBLIC_AUTH_SUPABASE_PUBLISHABLE_KEY",
        "AUTH_SUPABASE_SERVICE_ROLE_KEY",
        "NEXT_PUBLIC_ADMIN_URL",
        "NEXT_PUBLIC_STOREFRONT_URL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "CSP_REPORT_ONLY",
        "STOREFRONT_REVALIDATE_SECRET",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": []
    },
    "web#test": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/admin/testing/contracts/**"
      ]
    },
    "test:contract": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/admin/testing/contracts/**"
      ]
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "ALLOW_REMOTE_TEST_DATABASE"
      ]
    },
    "test:migrations": {
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "ALLOW_REMOTE_TEST_DATABASE"
      ]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_*",
        "VERCEL_ENV"
      ]
    },
    "test:smoke": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_*",
        "VERCEL_ENV"
      ]
    },
    "test:sanity": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_*",
        "VERCEL_ENV"
      ]
    },
    "test:security": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_*",
        "VERCEL_ENV"
      ]
    },
    "test:a11y": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_*",
        "VERCEL_ENV"
      ]
    },
    "test:visual": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_*",
        "VERCEL_ENV"
      ]
    },
    "test:cross-browser": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_*",
        "VERCEL_ENV"
      ]
    },
    "@repo/database#generate": {
      "cache": false
    }
  }
}
