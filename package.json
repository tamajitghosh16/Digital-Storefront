{
  "name": "digital-storefront",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.2.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:contract": "turbo run test:contract",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:migrations": "npm run test:migrations --workspace=@repo/database",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "test:smoke": "turbo run test:smoke --concurrency=1",
    "test:sanity": "turbo run test:sanity --concurrency=1",
    "test:security": "turbo run test:security --concurrency=1",
    "test:a11y": "turbo run test:a11y --concurrency=1",
    "test:visual": "turbo run test:visual --concurrency=1",
    "test:cross-browser": "turbo run test:cross-browser --concurrency=1",
    "test:perf": "npm run test:perf --workspace=web",
    "test:load": "npm run test:load --workspace=web",
    "db:test:start": "npm run db:test:start --workspace=@repo/database",
    "db:generate": "npm run generate --workspace=@repo/database",
    "db:migrate": "npm run migrate --workspace=@repo/database",
    "db:studio": "npm run studio --workspace=@repo/database",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0"
  }
}
