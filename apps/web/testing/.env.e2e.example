# Copy to .env.e2e (gitignored) for Playwright. Never real customer details.

# A test customer in the storefront Supabase project (ideally a separate test
# project). Leave blank to skip the signed-in tests.
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=

# Test a running deployment instead of starting `npm run dev` on :3000,
# e.g. https://staging.example.in for a post-deploy smoke run.
E2E_WEB_URL=
# Set to 1 when E2E_WEB_URL is the production site (robots.txt differs).
E2E_PRODUCTION=
