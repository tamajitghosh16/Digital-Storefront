NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Needed to mint short-lived signed download URLs for purchased
# e-book PDFs (app/api/library/[assetId]). Same key apps/admin uses for image
# uploads; pair it with a PRIVATE Supabase Storage bucket named "ebooks".
# Never prefix a secret with NEXT_PUBLIC_ — the app refuses to boot if you do.
SUPABASE_SERVICE_ROLE_KEY=
# Runtime connection (pooled). Prefer the least-privilege `app_runtime` role
# from packages/database/prisma/sql/app_runtime_role.sql over `postgres`.
# DIRECT_URL is only for migrations — it lives in packages/database/.env,
# not here.
DATABASE_URL=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required whenever RAZORPAY_KEY_ID is set (the app refuses to boot in
# production otherwise) — without it every webhook is rejected.
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Vercel Blob — only for the (future) customer-upload staging pipeline.
BLOB_READ_WRITE_TOKEN=
# Malware scanning for customer uploads. Without it, uploads stay PENDING
# (never CLEAN) and are not served.
CLOUDMERSIVE_API_KEY=
# Rate limiting that holds across serverless instances (Upstash Redis REST).
# Without these, limits are per-instance only. Also the data cache's store
# when CACHE_STORE=redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Where the storefront's data cache lives (docs/adr/0001-caching-strategy.md).
# `redis` keeps it in Upstash Redis above — shared by every server process and
# kept across restarts and redeploys; use it on Hostinger or any self-hosted
# production. Unset: Next's built-in per-process cache (local development,
# Vercel). Read at BUILD time — set it before the build. Same value on admin.
CACHE_STORE=
# With CACHE_STORE=redis: which environment's entries these are, e.g. `prod` or
# `staging`, so environments sharing one Redis never read each other's cache.
# Required then; set the SAME value on apps/admin.
CACHE_NAMESPACE=
# `1` logs every cache miss as it happens (a `cache.stats` summary is logged
# once a minute regardless).
CACHE_DEBUG=
# Escape hatch: `true` switches the Content-Security-Policy to report-only.
CSP_REPORT_ONLY=
# Which deployment this is: `production` on the live site, anything else
# (e.g. `staging`) on a copy. Vercel sets VERCEL_ENV itself, so leave this unset
# there; on Hostinger or a VPS set it. `production` makes robots.txt allow
# indexing and makes the app refuse to boot with Razorpay TEST keys. Read at
# build time too, so set it before the build.
DEPLOY_ENV=
# Shared secret apps/admin sends to /api/revalidate after a CMS or catalogue
# save, so the storefront drops exactly the cached reads that save changed.
# Set the SAME value in apps/admin (e.g. `openssl rand -hex 32`). Unset turns
# the endpoint off: with CACHE_STORE=redis admin still expires entries through
# Redis; otherwise edits show up within the cache TTL (5 minutes).
STOREFRONT_REVALIDATE_SECRET=
# This site's canonical public origin, e.g. https://www.example.in — used for
# absolute URLs in sitemap.xml and robots.txt. Same value as apps/admin's
# NEXT_PUBLIC_STOREFRONT_URL. On Vercel it falls back to the project's
# production domain; locally to http://localhost:3000. Anywhere else (Hostinger)
# it must be set, before the build.
NEXT_PUBLIC_STOREFRONT_URL=
# Floating "WhatsApp us" button. The owner's number in international format,
# country code first, e.g. +91 98765 43210 (spaces/dashes/+ are stripped).
# Unset or invalid hides the button. Not a secret — it ends up in the page —
# and deliberately not NEXT_PUBLIC_, so changing it needs no rebuild.
WHATSAPP_NUMBER=
# Optional message pre-filled in the chat, e.g. "Hello! I have a question."
WHATSAPP_GREETING=
