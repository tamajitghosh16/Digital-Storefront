NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Needed to mint short-lived signed download URLs for purchased
# e-book PDFs (app/api/library/[assetId]). Same key apps/admin uses for image
# uploads; pair it with a PRIVATE Supabase Storage bucket named "ebooks".
# Never prefix a secret with NEXT_PUBLIC_ — the app refuses to boot if you do.
SUPABASE_SERVICE_ROLE_KEY=
# Runtime connection (pooled). Prefer the least-privilege `app_runtime` role
# from packages/database/prisma/sql/app_runtime_role.sql over `postgres`.
# DIRECT_URL is only for migrations — it lives in packages/database/.env,
# not here.
DATABASE_URL=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required whenever RAZORPAY_KEY_ID is set (the app refuses to boot in
# production otherwise) — without it every webhook is rejected.
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Vercel Blob — only for the (future) customer-upload staging pipeline.
BLOB_READ_WRITE_TOKEN=
# Malware scanning for customer uploads. Without it, uploads stay PENDING
# (never CLEAN) and are not served.
CLOUDMERSIVE_API_KEY=
# Rate limiting that holds across serverless instances (Upstash Redis REST).
# Without these, limits are per-instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Escape hatch: `true` switches the Content-Security-Policy to report-only.
CSP_REPORT_ONLY=
# Shared secret apps/admin sends to /api/revalidate after a CMS save, so the
# storefront drops its cached site settings / menus / homepage copy at once.
# Set the SAME value in apps/admin (e.g. `openssl rand -hex 32`). Unset turns
# the endpoint off and CMS edits show up within a minute instead.
STOREFRONT_REVALIDATE_SECRET=
# This site's canonical public origin, e.g. https://www.example.in — used for
# absolute URLs in sitemap.xml and robots.txt. Same value as apps/admin's
# NEXT_PUBLIC_STOREFRONT_URL. On Vercel it falls back to the project's
# production domain; locally to http://localhost:3000.
NEXT_PUBLIC_STOREFRONT_URL=
# Floating "WhatsApp us" button. The owner's number in international format,
# country code first, e.g. +91 98765 43210 (spaces/dashes/+ are stripped).
# Unset or invalid hides the button. Not a secret — it ends up in the page —
# and deliberately not NEXT_PUBLIC_, so changing it needs no rebuild.
WHATSAPP_NUMBER=
# Optional message pre-filled in the chat, e.g. "Hello! I have a question."
WHATSAPP_GREETING=
