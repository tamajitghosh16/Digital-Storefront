# Copy to .env.e2e (gitignored) for Playwright. Never the Owner's own login.

# A dedicated test staff account in the admin auth project, with the lowest
# role the tests need (SUPPORT). Leave blank to skip the signed-in tests.
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=

# Test a running deployment instead of starting `npm run dev` on :3001.
E2E_ADMIN_URL=
