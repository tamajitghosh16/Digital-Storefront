# ── Authentication: the DEDICATED admin Supabase project ──────────────────
# apps/admin authenticates against its own Supabase project so staff
# identities can never be created by the storefront's public signup form.
# Create a second Supabase project, run packages/database/prisma/sql/sync_staff.sql
# in its SQL editor, disable email sign-ups on it, then fill these in from
# Project Settings → API. packages/auth reads these (falling back to the
# NEXT_PUBLIC_SUPABASE_* pair below when unset).
NEXT_PUBLIC_AUTH_SUPABASE_URL=
NEXT_PUBLIC_AUTH_SUPABASE_PUBLISHABLE_KEY=
# Service-role key for the admin auth project (Project Settings → API →
# service_role). REQUIRED for the Owner staff-invite flow on Staff & roles:
# it creates the staff auth identity, reads the full staff list, and changes
# roles. Falls back to SUPABASE_SERVICE_ROLE_KEY (storefront project) when
# blank — fine only until the dedicated admin auth project exists.
AUTH_SUPABASE_SERVICE_ROLE_KEY=

# ── The STOREFRONT Supabase project ──────────────────────────────────────
# Same project apps/web uses. Here it is ONLY for: cover/banner image uploads
# (packages/storage writes to its "images" Storage bucket) and any
# service-role data operation. NOT used for auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Shared business/CMS Postgres (the storefront project's database) ──────
DATABASE_URL=
DIRECT_URL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Resend API key + verified From address. REQUIRED for staff invitations —
# the "Send sign-up invite link" button emails through Resend (@repo/email).
RESEND_API_KEY=
EMAIL_FROM="Book Press <no-reply@example.com>"
# Cover/banner image uploads (app/api/uploads) go to the public "images"
# Supabase Storage bucket, using NEXT_PUBLIC_SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY above. No separate token needed; without those
# the admin's image fields fall back to "use a link instead" and say so.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Where the back office's "View storefront" link points. Defaults to
# http://localhost:3000 when unset.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
# This app's own public origin, used to build staff sign-up invite links
# (`/join/<token>`). Falls back to the request host, then http://localhost:3001.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
