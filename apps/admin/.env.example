# Cover/banner image uploads (app/api/uploads) go to the public "images"
# Supabase Storage bucket, using NEXT_PUBLIC_SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY above. No separate token needed; without those
# the admin's image fields fall back to "use a link instead" and say so.
INNGEST_EVENT_KEY=
