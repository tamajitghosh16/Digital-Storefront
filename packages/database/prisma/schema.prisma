// Digital Storefront — Shashibhushan's New School Book Press
// Prisma schema — mirrors the Data Model in the Technical Design Document
// (Section 3.2) and the BRD's Data Model Overview (Section 7) one-to-one.

generator client {
  provider = "prisma-client-js"
}

// Connection URLs moved to prisma.config.ts (Prisma 7) — see that file
// for the CLI/migrate connection and src/client.ts for the runtime adapter.
datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────

enum Role {
  GUEST
  READER
  SELF_PUB_AUTHOR
  SUPPORT
  EDITOR
  OWNER
}

enum ProductType {
  PHYSICAL_BOOK
  EBOOK
  SERVICE_PACKAGE
}

enum BookFormat {
  PHYSICAL
  EBOOK
}

/// The 8 product lines the Press sells across its 5 fixed storefront
/// departments (Educational Materials, Professional Materials, Digital &
/// Tech Solutions, Lifestyle — Publishing's 2 services aren't Product rows,
/// see ServiceRequest/SelfPublishingProject instead). Canonical labels,
/// departments and slugs live in `src/taxonomy.ts`, not here — this enum is
/// deliberately just the stable identifiers a Product row is tagged with.
enum ProductLine {
  BOOK
  EDUCATIONAL_CHART
  WORKSHEET_ACTIVITY_PUZZLE
  TEACHING_LEARNING_MATERIAL
  ADVOCATE_DIARY
  NAYA_BANDHU_APP
  DIGITAL_TRACKING_SYSTEM
  INDOOR_PLANT
}

/// Merchandising label shown against an inventory row in apps/admin's Books
/// list (and available to the storefront). Curated, not derived from
/// stockQty — an operator marks a title "Best Selling" or "Coming Soon"
/// regardless of the count on hand. Null means "no special status".
enum InventoryStatus {
  BEST_SELLING
  COMING_SOON
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  READY_FOR_DOWNLOAD
  CANCELLED
  REFUNDED
}

enum FulfillmentType {
  SHIP
  DIGITAL
  SERVICE
}

enum ProjectStatus {
  SUBMITTED
  IN_REVIEW
  IN_PRODUCTION
  PROOF_READY
  PUBLISHED
  REJECTED
}

enum ServiceRequestStatus {
  SUBMITTED
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
  OTHER
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FileAssetKind {
  MANUSCRIPT
  COVER_IMAGE
  PROOF
  EBOOK_FILE
  SOURCE_FILE
  DELIVERY_FILE
}

enum NavLocation {
  HEADER
  FOOTER
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// ────────────────────────────────────────────────────────────
// Core models
// ────────────────────────────────────────────────────────────

/// Mirrors Supabase's auth.users via a 1:1 synced row (id = auth.users.id).
/// A Postgres trigger (see prisma/sql/sync_user.sql, applied as a migration)
/// inserts/updates this row whenever auth.users changes.
model User {
  id          String   @id @db.Uuid
  name        String?
  email       String   @unique
  role        Role     @default(READER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addresses         Address[]
  orders            Order[]
  selfPubProjects   SelfPublishingProject[]
  serviceRequests   ServiceRequest[]
  reviews           Review[]
  notifications     Notification[]

  @@map("users")
}

model Address {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String? // "Home", "Office", ...
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("addresses")
}

model Product {
  id          String      @id @default(cuid())
  type        ProductType
  // Which of the 8 fixed product lines this listing belongs to. Null for
  // SERVICE_PACKAGE rows outside that taxonomy (e.g. e-book conversion
  // packages sold from /services) and for anything not yet migrated.
  productLine ProductLine?
  title       String
  author      String
  slug        String      @unique
  description String?
  priceCents  Int
  // Set only when bookFormats includes both PHYSICAL and EBOOK — the two
  // formats of the same title are priced separately (e-books undercut
  // print). priceCents alone is still the whole story for a single-format
  // book, so this stays null for everything else.
  ebookPriceCents Int?
  currency    String      @default("INR")
  coverImageUrl String?

  // Books only — which format(s) this book is sold in. A book can be
  // physical-only, e-book-only, or both at once; [] for service packages.
  bookFormats BookFormat[] @default([])

  // Books only
  stockQty    Int?
  isbn        String?
  weightGrams Int?
  // Curated merchandising status ("Best Selling" / "Coming Soon" / "Out of
  // Stock") an operator sets on a title. Independent of stockQty — see the
  // InventoryStatus enum. Null for an ordinary in-stock listing.
  inventoryStatus InventoryStatus?
  // The storefront's genre facet (apps/web's BOOK_GENRES) and aggregate
  // rating. Both default to zero rather than null, deliberately: nothing
  // writes them yet (no review-aggregation job exists), and a plain 0
  // avoids null-handling in the listing's sort/keyset-pagination columns.
  // The storefront only ever displays a rating when reviewCount > 0 — see
  // `rowToListing()` in apps/web/lib/books-data.ts — so an unreviewed book
  // still reads as "no rating yet", not "rated zero".
  genre       String?
  ratingAvg   Float    @default(0)
  reviewCount Int      @default(0)

  // E-books only
  formats     String[]    @default([]) // EPUB, MOBI, PDF
  sampleUrl   String?

  // Service packages only
  turnaroundDays Int?

  // Set if this listing originated from a published self-publishing project
  sourceProjectId String?               @unique
  sourceProject   SelfPublishingProject? @relation(fields: [sourceProjectId], references: [id])

  // Admin-controlled SEO/social metadata, rendered on the web product page.
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?

  isPublished Boolean   @default(true)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  fileAssets  FileAsset[]
  orderItems  OrderItem[]
  reviews     Review[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([type])
  @@index([slug])
  @@index([productLine])
  @@index([genre])
  @@index([ratingAvg])
  @@index([reviewCount])
  @@index([inventoryStatus])
  @@map("products")
}

model Order {
  id             String      @id @default(cuid())
  userId         String?     @db.Uuid // null for guest checkout
  user           User?       @relation(fields: [userId], references: [id])
  guestEmail     String?
  status         OrderStatus @default(PENDING)

  subtotalCents  Int
  taxCents       Int         @default(0)
  shippingCents  Int         @default(0)
  totalCents     Int

  shippingAddressId String?
  billingAddressId  String?

  trackingNumber String?
  carrier        String?

  items          OrderItem[]
  payment        Payment?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  quantity        Int             @default(1)
  unitPriceCents  Int
  fulfillmentType FulfillmentType

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model SelfPublishingProject {
  id               String        @id @default(cuid())
  authorId         String        @db.Uuid
  author           User          @relation(fields: [authorId], references: [id])
  bookTitle        String
  synopsis         String?
  selectedPackage  String        // "Starter" | "Guided" | "Full-Service"
  addOns           String[]      @default([])
  status           ProjectStatus @default(SUBMITTED)
  targetPriceCents Int?
  royaltyRateBps   Int?          // basis points, e.g. 7000 = 70%

  linkedProduct    Product?

  fileAssets       FileAsset[]
  royalties        Royalty[]
  payments         Payment[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([authorId])
  @@index([status])
  @@map("self_publishing_projects")
}

model ServiceRequest {
  id            String                @id @default(cuid())
  customerId    String                @db.Uuid
  customer      User                  @relation(fields: [customerId], references: [id])
  serviceType   String                // "conversion-only", "formatting", ...
  targetFormats String[]              @default([])
  status        ServiceRequestStatus  @default(SUBMITTED)
  etaDate       DateTime?

  fileAssets    FileAsset[]

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("service_requests")
}

model Royalty {
  id             String       @id @default(cuid())
  projectId      String
  project        SelfPublishingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  salesPeriodStart DateTime
  salesPeriodEnd   DateTime
  grossSalesCents  Int
  royaltyRateBps   Int
  amountOwedCents  Int
  payoutStatus     PayoutStatus @default(PENDING)
  payoutRef        String?      // RazorpayX payout id
  createdAt        DateTime     @default(now())

  @@index([projectId])
  @@map("royalties")
}

model Review {
  id               String            @id @default(cuid())
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String            @db.Uuid
  user             User              @relation(fields: [userId], references: [id])
  rating           Int               // 1-5
  title            String?
  body             String?
  moderationStatus ModerationStatus  @default(PENDING)
  createdAt        DateTime          @default(now())

  @@index([productId])
  @@unique([productId, userId]) // one review per verified purchaser
  @@map("reviews")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String?       @unique
  order             Order?        @relation(fields: [orderId], references: [id])
  projectId         String?
  project           SelfPublishingProject? @relation(fields: [projectId], references: [id])

  gatewayOrderId    String?       // Razorpay order_id
  gatewayPaymentId  String?       // Razorpay payment_id
  gatewaySignature  String?

  amountCents       Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            PaymentMethod?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([gatewayOrderId])
  @@map("payments")
}

/// Manuscripts, cover images, proofs, e-book files, and service deliverables.
/// Physically stored in Vercel Blob; this row is the metadata + entitlement
/// record used to mint short-lived signed download URLs.
model FileAsset {
  id                String        @id @default(cuid())
  kind              FileAssetKind
  blobPath          String        // path within Vercel Blob
  fileName          String
  mimeType          String
  sizeBytes         Int
  malwareScanStatus String        @default("PENDING") // PENDING | CLEAN | INFECTED
  downloadCount     Int           @default(0)
  maxDownloads      Int?          // FR-9.2 device/redownload limit

  productId         String?
  product           Product?      @relation(fields: [productId], references: [id])
  selfPubProjectId  String?
  selfPubProject    SelfPublishingProject? @relation(fields: [selfPubProjectId], references: [id])
  serviceRequestId  String?
  serviceRequest    ServiceRequest? @relation(fields: [serviceRequestId], references: [id])

  createdAt         DateTime      @default(now())

  @@index([productId])
  @@index([selfPubProjectId])
  @@index([serviceRequestId])
  @@map("file_assets")
}

/// FR-12: order/shipping/project-status/submission notifications, fanned out
/// to email (Resend) by an Inngest function; this row is the in-app record.
model Notification {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "order.confirmed" | "project.status_changed" | ...
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

/// FR-11.6 / NFR-9: every admin mutation on orders, royalties, and content
/// is recorded here for audit purposes.
model AuditLog {
  id     String @id @default(cuid())
  // The actor's auth UID. NOT a foreign key: staff authenticate against a
  // separate Supabase project (see packages/auth) whose UIDs have no row in
  // this database's `users` table, which holds storefront customers only.
  // `actorEmail` is denormalised alongside so an entry stays legible without
  // a cross-project lookup.
  actorId    String  @db.Uuid
  actorEmail String?
  action     String // "order.status_changed", "product.updated", ...
  entity     String // "Order", "Product", "SelfPublishingProject", ...
  entityId   String
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

/// A one-time, time-boxed invitation for a new back-office staff member.
/// Created by an Owner from apps/admin's Staff & roles screen; consumed once
/// at `/join/<token>` where the person sets a password. Staff identities
/// themselves live in the dedicated admin auth Supabase project (see
/// packages/auth) — this table only governs who may reach the sign-up form
/// and for how long. `tokenHash` is a SHA-256 of the random token that goes
/// in the emailed URL; the raw token is never stored, so the link can't be
/// reconstructed from a database leak. apps/admin-only — no apps/web reads.
model StaffInvite {
  id             String    @id @default(cuid())
  email          String
  name           String
  /// SHA-256 (hex) of the raw invite token. The raw token exists only in the
  /// emailed `/join/<token>` link.
  tokenHash      String    @unique
  expiresAt      DateTime
  /// Set the moment the invite is redeemed; a non-null value makes the link dead.
  acceptedAt     DateTime?
  /// Auth UID + email of the Owner who sent the invite (admin auth project —
  /// no FK, same rationale as AuditLog.actorId).
  invitedById    String    @db.Uuid
  invitedByEmail String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
  @@map("staff_invites")
}

// ────────────────────────────────────────────────────────────
// Procurement: vendors the Press buys stock from, and the purchase
// orders raised against them. apps/admin-only — no apps/web reads.
// Receiving a PO writes straight to Product.stockQty (no
// StockMovement ledger exists yet — see docs/inventory-management-design.md).
// ────────────────────────────────────────────────────────────

/// A supplier the Press orders physical stock (reprints) from.
model Vendor {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  gstin       String?
  addressLine String?
  city        String?
  state       String?
  postalCode  String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@map("vendors")
}

/// A stock-replenishment order raised against a Vendor. `poNumber` is a
/// separate auto-incrementing display id ("PO-0001") since every other
/// model's id is a cuid, not something a human should read out loud.
model PurchaseOrder {
  id         String              @id @default(cuid())
  poNumber   Int                 @unique @default(autoincrement())
  vendorId   String
  vendor     Vendor              @relation(fields: [vendorId], references: [id])
  status     PurchaseOrderStatus @default(DRAFT)
  orderedAt  DateTime            @default(now())
  expectedAt DateTime?
  notes      String?
  /// Denormalized sum of items' quantityOrdered * unitCostCents, recomputed on every write.
  totalCents Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  items PurchaseOrderItem[]

  @@index([vendorId])
  @@index([status])
  @@map("purchase_orders")
}

/// A line item on a PurchaseOrder. Restricted to PHYSICAL_BOOK products —
/// the only product type with a real stockQty to receive against today.
model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCostCents    Int

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

// ────────────────────────────────────────────────────────────
// CMS: site-wide content controlled entirely from apps/admin and
// rendered read-only by apps/web. No runtime call between the two
// apps — admin writes these rows, web reads them straight from
// Postgres, same as it does for Product.
// ────────────────────────────────────────────────────────────

/// Singleton row (fixed id, see @repo/database's SITE_SETTINGS_ID) holding
/// site-wide branding, default SEO metadata, and contact/social info that
/// apps/web renders in its root layout (<head> metadata, header, footer).
model SiteSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("Shashibhushan's New School Book Press")
  tagline         String?
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  logoUrl         String?
  contactEmail    String?
  contactPhone    String?
  addressLine     String?
  socialLinks     Json? // { "twitter": "...", "facebook": "...", "instagram": "..." }
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}

/// A department-bar entry the Publisher creates from apps/admin's "Products
/// Menu". Distinct from the hardcoded `Department`s in apps/web's
/// navigation.ts — those two lists are merged at render time. Distinct from
/// `Product` too: this is a nav/page entity (a category gets a blank landing
/// page and a dropdown), not a commerce line item with price/stock.
model MenuCategory {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  order     Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  products  MenuProduct[]

  @@map("menu_categories")
}

/// A single dropdown entry under a `MenuCategory`, rendered as its own blank
/// storefront page at /<slug> until the admin CMS grows real page content
/// for it.
model MenuProduct {
  id         String       @id @default(cuid())
  name       String
  slug       String       @unique
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order      Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([categoryId])
  @@map("menu_products")
}

/// Visibility overrides for apps/web's hardcoded department-bar entries —
/// the five fixed business lines in apps/web's navigation.ts, mirrored in
/// apps/admin's app/menu/fixed-departments.ts. Those aren't `MenuCategory`
/// rows, so hiding one from the storefront's top menu is recorded here,
/// keyed by the stable slug both apps agree on (`educational-materials`,
/// `professional-materials`, `digital-tech-solutions`, `services`,
/// `lifestyle`). No row = shown (the default); `hidden = true` drops it
/// from `buildDepartments()`.
model DepartmentVisibility {
  key       String   @id
  hidden    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("department_visibility")
}

/// Header and footer navigation, fully admin-managed (replaces the
/// hardcoded <nav> links that used to live in apps/web/app/layout.tsx).
model NavLink {
  id        String      @id @default(cuid())
  label     String
  href      String
  location  NavLocation
  order     Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([location])
  @@map("nav_links")
}

/// Homepage hero/promo banners.
model Banner {
  id        String   @id @default(cuid())
  /// Small label above the headline ("New this season").
  eyebrow   String?
  title     String
  subtitle  String?
  imageUrl  String?
  ctaText   String?
  ctaHref   String?
  /// Optional second button beside the main one ("Shop books").
  secondaryCtaText String?
  secondaryCtaHref String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

/// Storefront FAQ entries.
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

/// Customer/author testimonials shown on the homepage.
model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  quote      String
  rating     Int? // 1-5
  imageUrl   String?
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("testimonials")
}

/// Every other piece of storefront copy — section headings, their
/// descriptions, button labels — as an admin-editable override keyed by a
/// stable string. The catalogue of keys (with the label, help text and
/// default copy each one carries) lives in `src/content.ts`, not here: only
/// keys the Publisher has actually changed get a row, so the storefront
/// falls back to the shipped default and can never render blank.
model ContentBlock {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("content_blocks")
}

/// Singleton row (fixed id, see PRICING_SETTINGS_ID) holding the storefront
/// pricing rules that aren't per-product: delivery thresholds and fees, the
/// print + e-book bundle uplift, and GST rates. Defaults here mirror what
/// apps/web's lib/pricing.ts used to hardcode.
model PricingSettings {
  id                    String   @id @default(cuid())
  /// Order subtotal at or above which standard delivery is free.
  freeDeliveryOverCents Int      @default(150000)
  expressFeeCents       Int      @default(14900)
  sameDayFeeCents       Int      @default(24900)
  /// Human-written arrival estimates shown beside each delivery speed.
  standardEta           String   @default("in 3-5 working days")
  expressEta            String   @default("next working day")
  sameDayEta            String   @default("by 9pm today")
  /// Flat amount added to a printed copy when the reader takes both editions.
  bundleEbookAddCents   Int      @default(30000)
  /// GST in basis points (1800 = 18%). Printed books are nil-rated (HSN 4901).
  ebookGstBps           Int      @default(1800)
  serviceGstBps         Int      @default(1800)
  /// The example title price the homepage class-set table is priced from.
  classSetBaseCents     Int      @default(49900)
  updatedAt             DateTime @updatedAt

  @@map("pricing_settings")
}

/// Quantity breaks for class sets — schools buying one title in bulk.
/// Empty table means no tiers are offered.
model ClassSetTier {
  id          String   @id @default(cuid())
  quantity    Int      @unique
  /// Fraction off the single-copy price, in basis points (1000 = 10% off).
  discountBps Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("class_set_tiers")
}

/// Checkout discount codes. Matched case-insensitively by storing `code`
/// already upper-cased at write time.
model DiscountCode {
  id        String   @id @default(cuid())
  code      String   @unique
  /// Fraction off the order, in basis points (500 = 5% off).
  rateBps   Int
  blurb     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("discount_codes")
}
